{
  "name": "dotascope",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.17.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:https": "next dev --turbopack --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --fix --no-warn-ignored",
    "prettier": "prettier --write .",
    "prepare": "husky",
    "test": "jest --coverage",
    "test:ci": "jest --ci --coverage",
    "test:watch": "jest --watchAll",
    "docs": "npx typedoc --entryPointStrategy Expand src"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "5.1.1",
    "@mui/material": "7.2.0",
    "@mui/material-nextjs": "7.2.0",
    "@reduxjs/toolkit": "2.9.2",
    "@tanstack/react-query": "5.83.0",
    "@types/validator": "13.15.2",
    "axios": "1.12.2",
    "next": "15.5.9",
    "next-auth": "4.24.13",
    "opendota.js": "2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "7.60.0",
    "react-redux": "9.2.0",
    "swiper": "11.2.10",
    "validator": "13.15.23",
    "zod": "4.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/lodash.debounce": "4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swiper": "5.4.3",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-jest-dom": "5.5.0",
    "eslint-plugin-testing-library": "7.5.4",
    "husky": "9.1.7",
    "jest": "30.0.4",
    "jest-environment-jsdom": "30.0.4",
    "lint-staged": "16.1.2",
    "prettier": "3.6.2",
    "ts-jest": "29.4.0",
    "typedoc": "0.28.7",
    "typescript": "^5"
  },
  "overrides": {
    "eslint": "^9",
    "glob": "^10",
    "zod-to-json-schema": {
      "zod": "4.0.5"
    }
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write ."
    ],
    "**/*.html": [
      "prettier --write ."
    ]
  }
}
